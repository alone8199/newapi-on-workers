# 复制为 .dev.vars（本地开发）或设置为生产 Secrets（wrangler secret put）
# access token 签名密钥（必填，HMAC-SHA256 签发/校验登录 access token）
# 生产务必设置高强度随机串：wrangler secret put AUTH_SECRET
AUTH_SECRET=change-me-to-a-long-random-string

# 渠道 key 静态加密主密钥（可选；设置后 D1 中的渠道 key 用 AES-GCM 加密，读取时自动解密）
# 若与 MASTER_KEY 未设置，渠道 key 以明文（换行分隔纯文本）存储，与原版一致
MASTER_KEY=

# 可选：Bedrock 上游签名凭据
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 可选：Realtime WebSocket 上游与鉴权
REALTIME_UPSTREAM=
REALTIME_API_KEY=
